<!--
  Matty's Windows installer (#215), built with WiX 5 by
  scripts/windows-package. A per-user install, so it needs no
  administrator: Matty goes in %LOCALAPPDATA%\Programs\Matty with a Start
  menu shortcut that carries the AppUserModelID the app's toasts use, and
  registers the matty:// and mattermost:// links. It is not signed here.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Matty"
           Manufacturer="Matty"
           Version="$(Version)"
           UpgradeCode="3bea92bd-4210-4e23-8dc7-abf0959a0b7a"
           Scope="perUser"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer Matty is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Matty" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="App" Directory="INSTALLFOLDER">
      <Component Id="Binary">
        <File Id="MattyExe" Source="$(Binary)" Name="matty.exe" />
        <RegistryValue Root="HKCU" Key="Software\Matty" Name="Installed"
                       Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      </Component>

      <!-- The shortcut's AppUserModelID is what lets the app's toasts show. -->
      <Component Id="StartMenu" Directory="ProgramMenuFolder">
        <Shortcut Id="MattyShortcut" Name="Matty"
                  Description="Chat on your Mattermost server"
                  Target="[INSTALLFOLDER]matty.exe" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="dev.arya.matty" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Matty" Name="StartMenu"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="Links">
        <RegistryValue Root="HKCU" Key="Software\Classes\matty" Value="URL:Matty" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\Classes\matty" Name="URL Protocol" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\matty\shell\open\command"
                       Value="&quot;[INSTALLFOLDER]matty.exe&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\mattermost" Value="URL:Mattermost" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\mattermost" Name="URL Protocol" Value="" Type="string" />
        <RegistryValue Root="HKCU" Key="Software\Classes\mattermost\shell\open\command"
                       Value="&quot;[INSTALLFOLDER]matty.exe&quot; &quot;%1&quot;" Type="string" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="App" />
    </Feature>
  </Package>
</Wix>
