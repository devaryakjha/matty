[Desktop Entry]
# Matty's desktop entry (PLAN §6.7). It registers Matty for matty:// links
# and for the mattermost:// links a server's /login/desktop page and
# "Open in desktop app" hand off (#84). Exec gets the link as %u; a Matty
# already running takes it from the new launch, which then exits.
Type=Application
Name=Matty
GenericName=Mattermost client
Comment=Chat on your Mattermost server
Exec=matty %u
Icon=dev.arya.matty
Terminal=false
Categories=Network;InstantMessaging;Chat;
MimeType=x-scheme-handler/matty;x-scheme-handler/mattermost;
StartupWMClass=dev.arya.matty
