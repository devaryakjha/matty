## Offline refusals and empty panes (offline.rs)

offline-title = You're offline
# A refused action's toast: what did not happen, then when it can work again.
offline-notice = { $refused } Try again when you're back online.

offline-add-reaction = Couldn't add the reaction.
offline-remove-reaction = Couldn't remove the reaction.
offline-edit = Couldn't save your edit.
offline-delete = Couldn't delete the message.
offline-save-message = Couldn't save the message.
offline-unsave-message = Couldn't remove the message from Saved.
offline-pin-message = Couldn't pin the message.
offline-unpin-message = Couldn't unpin the message.
offline-mark-unread = Couldn't mark the message unread.
offline-set-reminder = Couldn't set the reminder.
offline-acknowledge = Couldn't acknowledge the message.
offline-remove-acknowledgement = Couldn't remove your acknowledgement.
offline-schedule-message = Couldn't schedule the message.
offline-change-scheduled-message = Couldn't change the scheduled message.
offline-delete-scheduled-message = Couldn't delete the scheduled message.
offline-run-action = Couldn't send your choice to the integration.
offline-run-command = Couldn't run the command.
offline-follow-thread = Couldn't follow the thread.
offline-unfollow-thread = Couldn't unfollow the thread.
offline-open-direct-message = Couldn't open the conversation.
offline-join-channel = Couldn't join the channel.
offline-leave-channel = Couldn't leave the channel.
offline-archive-channel = Couldn't archive the channel.
offline-create-channel = Couldn't create the channel.
offline-change-channel = Couldn't change the channel.
offline-change-channel-privacy = Couldn't make the channel private.
offline-change-notifications = Couldn't change the channel's notifications.
offline-add-members = Couldn't add the members.
offline-remove-member = Couldn't remove the member.
offline-set-status = Couldn't change your status.
offline-save-your-profile = Couldn't save your profile.
offline-change-your-picture = Couldn't change your picture.
offline-remove-your-picture = Couldn't remove your picture.

# The right pane while offline, by what it lists.
offline-empty-search = Search runs on the server. Try again when you're back online.
offline-empty-mentions = Recent mentions load from the server when you're back online.
offline-empty-unreads = Unread messages load from the server when you're back online.
offline-empty-saved = None of your saved messages are on this computer yet. They load when you're back online.
offline-empty-files = A channel's files load from the server when you're back online.
offline-empty-pinned = None of this channel's pinned messages are on this computer yet. They load when you're back online.
offline-empty-thread = Matty hasn't saved this thread on this computer yet. Its replies load when you're back online.
