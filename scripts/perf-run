#!/usr/bin/env python3
"""Drive Matty through a scripted journey and report PLAN §9's budgets (#174).

The app writes its perf log (crates/matty-app/src/perf.rs) when
MATTY_PERF_LOG names a file. This script starts the app with it, walks the
journey below, stops the app and turns the log into a Markdown report and a
JSON summary that later runs compare against with --baseline.

The journey:
  1. Start and wait for the first frame (and, with --server, sign in).
  2. Switch channels with Alt+Down eight times, then back with Alt+Up eight
     times. With --server the first visits are uncached, the way back cached.
  3. Open the long channel with the quick switcher and scroll the transcript
     up and back down with the wheel.
  4. Type a sentence into the composer, one key at a time, and clear it.
  5. Move to another channel, let the window settle, then touch nothing for
     --idle seconds (default 10). The report asserts that no frame was drawn.

Linux (and this repository's cloud container): needs Xvfb and xdotool. With
no DISPLAY, or with --xvfb, the script starts its own Xvfb.

    cargo build --release -p matty
    scripts/perf-run                      # preview fixtures, 10,000-post channel
    scripts/perf-run --server http://localhost:8065   # seeded dev server

macOS: xdotool is not there, so --manual launches the app with the log on
and prints each step for you to do by hand (the same keys: Option-Down,
Option-Up, Command-K, the trackpad, typing), then times the idle window
itself and writes the same report. Run it on the reference machine:

    cargo build --release -p matty
    scripts/perf-run --manual --server http://localhost:8065

--report LOG skips the journey and reports on an existing perf log.

The preview has no server, so its switches are all cached and there is no
WebSocket; the --server run is the one PLAN §9 means. Under Xvfb the app
renders in software, so frame times there are far from a real GPU's; compare
runs only against runs on the same machine.
"""

import argparse
import json
import os
import platform
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
WINDOW = (1200, 800)
SENTENCE = "the quick brown fox jumps over the lazy dog"

# PLAN §9: (key, metric, budget text, check on the summary or None).
BUDGETS = [
    ("first_paint", "Cold start to first frame", "< 500ms (sidebar visible)",
     lambda s: s["p50"] < 500),
    ("switch_cached", "Channel switch (cached) to first paint", "< 50ms",
     lambda s: s["p99"] < 50),
    ("switch_uncached", "Channel switch (uncached) to messages", "< 300ms",
     lambda s: s["p99"] < 300),
    ("scroll_frame", "Scroll frame time (long channel)", "p99 < 12ms",
     lambda s: s["p99"] < 12),
    ("key_to_glyph", "Keypress to glyph in composer", "< 16ms",
     lambda s: s["p99"] < 16),
    ("idle_frames", "Frames drawn while idle", "0", lambda s: s["count"] == 0),
    ("idle_frames_focused", "Frames while idle, composer focused", "(not budgeted)", None),
    ("idle_cpu", "Idle CPU", "~0%", lambda s: s["value"] < 1.0),
    ("idle_rss", "Idle memory (RSS)", "< 150MB", lambda s: s["value"] < 150),
]


def log(message):
    print(f"perf-run: {message}", file=sys.stderr, flush=True)


def percentile(values, q):
    ordered = sorted(values)
    if not ordered:
        return None
    index = min(len(ordered) - 1, max(0, round(q / 100 * (len(ordered) - 1))))
    return ordered[index]


def stats(values):
    return {
        "n": len(values),
        "p50": percentile(values, 50),
        "p99": percentile(values, 99),
        "max": max(values) if values else None,
    }


def read_log(path):
    events = []
    for line in Path(path).read_text().splitlines():
        try:
            events.append(json.loads(line))
        except json.JSONDecodeError:
            pass  # a line cut short when the app stopped
    return events


# --- Driving the app -------------------------------------------------------


class Xdo:
    """Input through xdotool on an X display."""

    def __init__(self, display, pid, shots=None):
        self.shots = shots
        self.env = {**os.environ, "DISPLAY": display}
        self.window = None
        deadline = time.time() + 30
        while time.time() < deadline and not self.window:
            found = self.run("search", "--onlyvisible", "--pid", str(pid), check=False)
            self.window = (found.split() or [None])[0]
            if not self.window:
                time.sleep(0.5)
        if not self.window:
            raise SystemExit("perf-run: the Matty window did not appear")
        self.run("windowfocus", "--sync", self.window, check=False)

    def run(self, *args, check=True):
        result = subprocess.run(
            ["xdotool", *args], env=self.env, capture_output=True, text=True
        )
        if check and result.returncode != 0:
            raise SystemExit(f"perf-run: xdotool {' '.join(args)}: {result.stderr.strip()}")
        return result.stdout

    def key(self, *keys):
        self.run("key", "--clearmodifiers", *keys)

    def type(self, text, delay_ms):
        self.run("type", "--delay", str(delay_ms), text)

    def move(self, x, y):
        self.run("mousemove", "--window", self.window, str(x), str(y))

    def shot(self, name):
        """Saves a screenshot with --shots, to check where the journey went."""
        if self.shots and shutil.which("import"):
            subprocess.run(["import", "-window", "root", str(self.shots / f"{name}.png")],
                           env=self.env, check=False)

    def click(self, x, y):
        self.move(x, y)
        self.run("click", "1")

    def scroll(self, up, clicks, delay_ms):
        self.run("click", "--repeat", str(clicks), "--delay", str(delay_ms), "4" if up else "5")


class Manual:
    """Prompts a person for each step, for platforms without xdotool."""

    def __init__(self):
        pass

    def step(self, text):
        input(f"\n>>> {text}\n    Press Return here when done. ")


def sign_in(xdo, server, login, password):
    xdo.type(server, 20)
    xdo.key("Return")
    time.sleep(2)
    xdo.type(login, 20)
    xdo.key("Tab")
    xdo.type(password, 20)
    xdo.key("Return")


def count(path, event):
    return sum(1 for e in read_log(path) if e.get("ev") == event)


def wait_for(path, event, timeout):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if path.exists() and any(e.get("ev") == event for e in read_log(path)):
            return True
        time.sleep(0.25)
    return False


def proc_sample(pid):
    """(CPU seconds, RSS in MB) of `pid`, or None where it cannot be read."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()
        ticks = os.sysconf("SC_CLK_TCK")
        cpu = (int(stat[11]) + int(stat[12])) / ticks
        rss = None
        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
            if line.startswith("VmRSS:"):
                rss = int(line.split()[1]) / 1024
        return cpu, rss
    except (OSError, IndexError, ValueError):
        pass
    try:  # macOS and other BSDs
        out = subprocess.run(
            ["ps", "-o", "cputime=,rss=", "-p", str(pid)], capture_output=True, text=True
        ).stdout.split()
        parts = [float(p) for p in out[0].replace("-", ":").split(":")]
        cpu = 0.0
        for part in parts:
            cpu = cpu * 60 + part
        return cpu, int(out[1]) / 1024
    except (IndexError, ValueError):
        return None


def journey(args, perf_log):
    """Runs the app through the journey; returns the driver's notes."""
    home = Path(tempfile.mkdtemp(prefix="matty-perf-home-"))
    settings = home / ".config" / "Matty"
    settings.mkdir(parents=True)
    (settings / "settings.json").write_text(json.dumps({
        "theme": "light",
        "window": {"x": 0, "y": 0, "width": WINDOW[0], "height": WINDOW[1]},
    }))
    # macOS keeps settings under Application Support.
    mac = home / "Library" / "Application Support" / "Matty"
    mac.mkdir(parents=True)
    shutil.copy(settings / "settings.json", mac / "settings.json")

    xvfb = None
    display = os.environ.get("DISPLAY")
    if not args.manual and (args.xvfb or not display):
        display = args.display
        xvfb = subprocess.Popen(
            ["Xvfb", display, "-screen", "0", f"{WINDOW[0]}x{WINDOW[1]}x24"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        time.sleep(1)

    env = {**os.environ, "HOME": str(home), "MATTY_PERF_LOG": str(perf_log)}
    if display:
        env["DISPLAY"] = display
    if args.server:
        env.pop("MATTY_PREVIEW", None)
    else:
        env["MATTY_PREVIEW"] = "1"
        env["MATTY_PREVIEW_POSTS"] = str(args.posts)
    app = subprocess.Popen(
        [str(args.bin)], env=env, stdout=subprocess.DEVNULL,
        stderr=open(args.out / "app.stderr", "w"),
    )
    notes = {"mode": "server" if args.server else "preview"}
    try:
        if not wait_for(perf_log, "first_paint", 120):
            raise SystemExit("perf-run: no frame within 120 s; see app.stderr")
        if args.manual:
            notes.update(manual_journey(args, app.pid))
        else:
            notes.update(xdo_journey(args, display, app.pid, perf_log))
    finally:
        app.send_signal(signal.SIGTERM)
        try:
            app.wait(10)
        except subprocess.TimeoutExpired:
            app.kill()
        if xvfb:
            xvfb.terminate()
        shutil.rmtree(home, ignore_errors=True)
    return notes


def idle_window(args, pid, seconds):
    """Touches nothing for `seconds`; returns the window and samples."""
    time.sleep(args.settle)
    before = proc_sample(pid)
    start = time.time()
    time.sleep(seconds)
    end = time.time()
    after = proc_sample(pid)
    notes = {"idle_start_ms": start * 1000, "idle_end_ms": end * 1000}
    if before and after:
        notes["idle_cpu_pct"] = 100 * (after[0] - before[0]) / (end - start)
        notes["idle_rss_mb"] = after[1]
    return notes


def settle(perf_log, at_least, quiet=0.3, timeout=3):
    """Waits `at_least` seconds, then until the app has drawn nothing for
    `quiet` seconds, so the next input does not land in a backlog (a debug
    build or a software renderer can lag well behind xdotool). Something
    that animates, such as a loading skeleton, ends the wait at `timeout`."""
    time.sleep(at_least)
    deadline = time.time() + timeout
    size, since = perf_log.stat().st_size, time.time()
    while time.time() < deadline:
        time.sleep(0.05)
        now = perf_log.stat().st_size
        if now != size:
            size, since = now, time.time()
        elif time.time() - since >= quiet:
            return


def xdo_journey(args, display, pid, perf_log):
    xdo = Xdo(display, pid, args.shots)
    if args.server:
        sign_in(xdo, args.server, args.login, args.password)
        xdo.shot("0-signing-in")
        settle(perf_log, 8, quiet=1)  # the first sync fills the sidebar
        # Nothing has focus after the sign-in card goes, so keys reach no
        # binding until a click in the window; then open a first channel.
        xdo.click(WINDOW[0] // 6, 16)
        xdo.key("ctrl+k")
        settle(perf_log, 0.3)
        xdo.type(args.start_channel, 40)
        settle(perf_log, 0.5)
        xdo.key("Return")
        settle(perf_log, 2, quiet=1)
        xdo.shot("0-start-channel")
    pause = 2.0 if args.server else 0.3
    for _ in range(8):
        xdo.key("alt+Down")
        settle(perf_log, pause)
    for _ in range(8):
        xdo.key("alt+Up")
        settle(perf_log, pause)

    xdo.key("ctrl+k")
    settle(perf_log, 0.3)
    xdo.type(args.long_channel, 40)
    settle(perf_log, 0.5)
    xdo.key("Return")
    settle(perf_log, 2 if args.server else 0.5, quiet=0.6)
    # Closes the switcher if the name was typed before it took focus.
    xdo.key("Escape")
    settle(perf_log, 0.3)
    xdo.move(WINDOW[0] * 3 // 5, WINDOW[1] // 2)
    settle(perf_log, 0.3)
    xdo.scroll(True, args.scroll, 16)
    settle(perf_log, 0.3)
    xdo.scroll(False, args.scroll, 16)
    settle(perf_log, 0.3)

    xdo.shot("1-scrolled")
    for _ in range(2):
        glyphs = count(perf_log, "key_to_glyph")
        xdo.click(WINDOW[0] * 3 // 5, WINDOW[1] - 72)  # the composer
        settle(perf_log, 0.3)
        xdo.type(SENTENCE, 120)
        settle(perf_log, 0.3)
        if count(perf_log, "key_to_glyph") > glyphs:
            break
        log("the composer took no text; trying once more")
    xdo.shot("2-typed")
    xdo.key("ctrl+a")
    xdo.key("BackSpace")
    # The composer keeps focus: its caret blinks.
    notes = {"focused": idle_window(args, pid, args.idle_focused)}

    xdo.key("alt+Down")
    settle(perf_log, 0.3)
    # An empty spot in the title bar takes focus out of the composer.
    xdo.click(WINDOW[0] // 6, 16)
    notes.update(idle_window(args, pid, args.idle))
    return notes


def manual_journey(args, pid):
    person = Manual()
    if args.server:
        person.step(f"Sign in to {args.server} as {args.login}.")
    person.step("Press Option-Down eight times, a second apart, then Option-Up eight times.")
    person.step(
        f"Press Command-K, type {args.long_channel}, press Return, then scroll the "
        "transcript up a long way and back down."
    )
    person.step(
        "Click into the composer and type a sentence at an even pace, then select "
        "it all and delete it. Do not send it. Leave the composer focused."
    )
    log(f"idle, composer focused: hands off for {args.settle + args.idle_focused:.0f} s")
    notes = {"focused": idle_window(args, pid, args.idle_focused)}
    person.step(
        "Press Option-Down once, click an empty spot in the title bar, then let "
        "go of the mouse and keyboard."
    )
    log(f"idle: hands off for {args.settle + args.idle:.0f} s")
    notes.update(idle_window(args, pid, args.idle))
    return notes


# --- The report ------------------------------------------------------------


def summarize(events, notes):
    start = next((e for e in events if e.get("ev") == "start"), {})
    epoch = start.get("epoch_ms")
    frames = [e for e in events if e.get("ev") == "frame"]
    summary = {}

    first = [e["ms"] for e in events if e.get("ev") == "first_paint"]
    if first:
        summary["first_paint"] = stats(first)
    switches = [e for e in events if e.get("ev") == "switch"]
    for cached, key in ((True, "switch_cached"), (False, "switch_uncached")):
        values = [e["ms"] for e in switches if e.get("cached") is cached]
        if values:
            summary[key] = stats(values)
    scroll = [e["dur"] for e in frames if e.get("input") == "scroll" and e["since_input"] < 100]
    if scroll:
        summary["scroll_frame"] = stats(scroll)
        summary["scroll_frame"]["over_16ms"] = sum(1 for d in scroll if d > 1000 / 60)
    glyphs = [e["ms"] for e in events if e.get("ev") == "key_to_glyph"]
    if glyphs:
        summary["key_to_glyph"] = stats(glyphs)
    if epoch is not None and "idle_start_ms" in notes:
        lo = notes["idle_start_ms"] - epoch
        hi = notes["idle_end_ms"] - epoch
        idle = [e for e in frames if lo <= e["t"] <= hi]
        summary["idle_frames"] = {
            "count": len(idle),
            "seconds": round((hi - lo) / 1000, 1),
            "inputs": sorted({e["input"] for e in idle}),
        }
    focused = notes.get("focused", {})
    if epoch is not None and "idle_start_ms" in focused:
        lo = focused["idle_start_ms"] - epoch
        hi = focused["idle_end_ms"] - epoch
        summary["idle_frames_focused"] = {
            "count": sum(1 for e in frames if lo <= e["t"] <= hi),
            "seconds": round((hi - lo) / 1000, 1),
            "inputs": [],
        }
    if "idle_cpu_pct" in notes:
        summary["idle_cpu"] = {"value": notes["idle_cpu_pct"], "unit": "%"}
    if notes.get("idle_rss_mb") is not None:
        summary["idle_rss"] = {"value": notes["idle_rss_mb"], "unit": "MB"}
    summary["frames"] = {
        "count": len(frames),
        "dur": stats([e["dur"] for e in frames]),
        # The app's own count: frames over a second after the last input.
        "app_idle_frames": frames[-1]["idle_frames"] if frames else 0,
    }
    summary["meta"] = {"debug_build": start.get("debug"), "version": start.get("version")}
    return summary


def fmt(value, unit="ms"):
    return "–" if value is None else f"{value:.1f}{unit}"


def describe(key, s):
    if key.startswith("idle_frames"):
        extra = f" (inputs: {', '.join(s['inputs'])})" if s["inputs"] else ""
        return f"{s['count']} frames in {s['seconds']} s{extra}"
    if key in ("idle_cpu", "idle_rss"):
        return fmt(s["value"], s["unit"])
    text = f"p50 {fmt(s['p50'])}, p99 {fmt(s['p99'])}, max {fmt(s['max'])} (n={s['n']})"
    if "over_16ms" in s:
        text += f"; {s['over_16ms']} over 16.7ms"
    return text


def headline(key, s):
    """The one number a baseline column shows."""
    if key.startswith("idle_frames"):
        return str(s["count"])
    if key in ("idle_cpu", "idle_rss"):
        return fmt(s["value"], s["unit"])
    return f"p99 {fmt(s['p99'])}"


def git(*args):
    try:
        return subprocess.run(
            ["git", *args], cwd=ROOT, capture_output=True, text=True
        ).stdout.strip()
    except OSError:
        return ""


def machine():
    name = platform.platform()
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith("model name"):
                return f"{name}, {line.split(':', 1)[1].strip()}, {os.cpu_count()} CPUs"
    except OSError:
        pass
    return f"{name}, {platform.machine()}, {os.cpu_count()} CPUs"


def report(summary, notes, baseline):
    mode = notes.get("mode", "log")
    build = "debug" if summary["meta"].get("debug_build") else "release"
    lines = [
        "# Matty perf run",
        "",
        f"- Date: {time.strftime('%Y-%m-%d %H:%M %Z')}",
        f"- Commit: {git('rev-parse', '--short', 'HEAD') or 'unknown'}"
        + (" with local changes" if git("status", "--porcelain", "--untracked-files=no") else ""),
        f"- Build: {build}, matty {summary['meta'].get('version')}",
        f"- Mode: {mode}",
        f"- Machine: {machine()}",
        f"- Display: {notes.get('display', 'unknown')}".rstrip(),
        "",
        "| Metric | Budget (PLAN §9) | Result | Verdict |"
        + (" Baseline |" if baseline else ""),
        "| --- | --- | --- | --- |" + (" --- |" if baseline else ""),
    ]
    failed = []
    for key, name, budget, check in BUDGETS:
        s = summary.get(key)
        if s is None:
            verdict, result = "Not measured", "–"
        elif check is None:
            verdict, result = "Info", describe(key, s)
        else:
            ok = check(s)
            verdict = "**Pass**" if ok else "**Fail**"
            result = describe(key, s)
            if not ok:
                failed.append(key)
        row = f"| {name} | {budget} | {result} | {verdict} |"
        if baseline:
            b = baseline.get(key)
            row += f" {headline(key, b) if b else '–'} |"
        lines.append(row)
    frames = summary["frames"]
    lines += [
        "",
        f"All frames: {frames['count']}, {describe('frames', frames['dur'])} draw time; "
        f"the app counted {frames['app_idle_frames']} frames more than a second after input.",
        "",
        "Frame time is the CPU time from the root's render to the end of its paint; "
        "presenting is not included. Switch and keypress times run from the input "
        "event to the end of the frame that shows the result.",
    ]
    idle = summary.get("idle_frames")
    if idle is not None:
        verdict = "holds" if idle["count"] == 0 else "does NOT hold"
        lines += ["", f"Assertion: zero frames over {idle['seconds']} s idle ({mode}) {verdict}."]
    if mode == "preview":
        lines += [
            "",
            "Preview mode has no server: every switch is cached and no WebSocket is "
            "connected. Run with --server for PLAN §9's idle-with-WebSocket figure.",
        ]
    return "\n".join(lines) + "\n", failed


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--bin", type=Path, default=ROOT / "target" / "release" / "matty")
    parser.add_argument("--out", type=Path, default=Path("perf-out"))
    parser.add_argument("--server", help="sign in to this server instead of the preview")
    parser.add_argument("--login", default="tester")
    parser.add_argument("--password", default="Password1!")
    parser.add_argument("--long-channel", help="channel to scroll (default: general, or busy with --server)")
    parser.add_argument("--start-channel", default="town square",
                        help="with --server, the channel the switches start from")
    parser.add_argument("--posts", type=int, default=10000, help="posts in the preview's long channel")
    parser.add_argument("--scroll", type=int, default=150, help="wheel clicks each way")
    parser.add_argument("--idle", type=float, default=10.0, help="seconds of idle to assert")
    parser.add_argument("--idle-focused", type=float, default=5.0,
                        help="seconds of idle with the composer focused (reported, not asserted)")
    parser.add_argument("--settle", type=float, default=2.0, help="seconds before the idle window")
    parser.add_argument("--xvfb", action="store_true", help="start Xvfb even when DISPLAY is set")
    parser.add_argument("--display", default=":97", help="display for the Xvfb this starts")
    parser.add_argument("--manual", action="store_true", help="prompt for each step (macOS)")
    parser.add_argument("--shots", type=Path, help="save screenshots of the journey here")
    parser.add_argument("--report", type=Path, help="report on this perf log; no journey")
    parser.add_argument("--baseline", type=Path, help="summary.json of an earlier run to compare")
    args = parser.parse_args()
    if args.long_channel is None:
        args.long_channel = "busy" if args.server else "general"
    args.out.mkdir(parents=True, exist_ok=True)
    if args.shots:
        args.shots.mkdir(parents=True, exist_ok=True)

    if args.report:
        perf_log, notes = args.report, {}
    else:
        if not args.bin.exists():
            raise SystemExit(f"perf-run: no {args.bin}; run `cargo build --release -p matty`")
        if not args.manual and not shutil.which("xdotool"):
            raise SystemExit("perf-run: needs xdotool (or --manual on macOS)")
        perf_log = args.out / "perf.jsonl"
        perf_log.unlink(missing_ok=True)
        notes = journey(args, perf_log)
        notes["display"] = "Xvfb (software rendering)" if not args.manual and (
            args.xvfb or not os.environ.get("DISPLAY")) else "native"

    summary = summarize(read_log(perf_log), notes)
    baseline = json.loads(args.baseline.read_text()) if args.baseline else None
    text, failed = report(summary, notes, baseline)
    (args.out / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
    (args.out / "report.md").write_text(text)
    print(text, end="")
    idle = summary.get("idle_frames")
    if idle is not None and idle["count"] != 0:
        log("idle frames assertion failed")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
