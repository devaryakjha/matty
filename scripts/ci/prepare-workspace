#!/usr/bin/env bash
# Run right after actions/checkout on a self-hosted runner (docs/CI.md).
#
# A self-hosted runner reuses its checkout from job to job, and the workflows
# check out with `clean: false` there so target/ survives and cargo builds
# stay warm. This clears everything else a previous job left behind:
# untracked and ignored files outside target/, and the packages in
# target/dist, so a job never uploads an older build. target/ itself goes
# once it grows past MATTY_CI_TARGET_MAX_GB (default 60).
set -euo pipefail

cd "$(dirname "$0")/../.."
git clean -ffdx -e /target/
rm -rf target/dist

max_gb="${MATTY_CI_TARGET_MAX_GB:-60}"
if [[ -d target ]]; then
	used_kb="$(du -sk target | cut -f1)"
	echo "target/ holds $((used_kb / 1024 / 1024)) GB (limit ${max_gb} GB)"
	if ((used_kb > max_gb * 1024 * 1024)); then
		echo "Removing target/ to free disk space; this build starts cold"
		rm -rf target
	fi
fi
df -h . | tail -n 1
