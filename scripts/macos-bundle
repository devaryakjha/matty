#!/usr/bin/env bash
# Writes a macOS .app bundle around an already built `matty` binary and signs
# it. scripts/dev-bundle and scripts/release-bundle both use it, so the
# development and release bundles only differ in the values passed here.
#
#   scripts/macos-bundle --name NAME --id BUNDLE_ID --bin BINARY --out DIR \
#       [--scheme SCHEME]... [--version 1.2.3] [--build 42]
#
# The bundle is "DIR/NAME.app". The version defaults to the workspace version
# in Cargo.toml; a pre-release suffix ("-beta.1") is kept out of the
# Info.plist versions, which macOS wants as plain numbers.
#
# Signing: ad hoc by default. With MATTY_SIGN_IDENTITY set (a Developer ID
# Application identity in the keychain) it signs with the hardened runtime
# and a secure timestamp instead, as notarization requires (#178).
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

name="" bundle_id="" bin="" out="" version="" build=""
schemes=()
while [[ $# -gt 0 ]]; do
	case "$1" in
	--name) name="$2"; shift 2 ;;
	--id) bundle_id="$2"; shift 2 ;;
	--bin) bin="$2"; shift 2 ;;
	--out) out="$2"; shift 2 ;;
	--scheme) schemes+=("$2"); shift 2 ;;
	--version) version="$2"; shift 2 ;;
	--build) build="$2"; shift 2 ;;
	*) echo "macos-bundle: unknown argument $1" >&2; exit 2 ;;
	esac
done
for required in name bundle_id bin out; do
	[[ -n "${!required}" ]] || { echo "macos-bundle: missing --${required/bundle_/}" >&2; exit 2; }
done
[[ -x "$bin" ]] || { echo "macos-bundle: no binary at $bin" >&2; exit 1; }

if [[ -z "$version" ]]; then
	version="$(sed -n 's/^version = "\(.*\)"/\1/p' "$root/Cargo.toml" | head -n 1)"
fi
short_version="${version%%-*}"
build="${build:-$short_version}"

app="$out/$name.app"
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$bin" "$app/Contents/MacOS/matty"
cp "$root/LICENSE" "$root/NOTICE" "$app/Contents/Resources/"

scheme_lines=""
for scheme in ${schemes[@]+"${schemes[@]}"}; do
	scheme_lines+=$'\t\t\t\t'"<string>$scheme</string>"$'\n'
done
scheme_lines="${scheme_lines%$'\n'}"

# The app icon (#65) is optional until it lands.
icon_lines=""
icon="$root/packaging/macos/AppIcon.icns"
if [[ -f "$icon" ]]; then
	cp "$icon" "$app/Contents/Resources/AppIcon.icns"
	icon_lines=$'\t<key>CFBundleIconFile</key>\n\t<string>AppIcon</string>'
fi

template="$root/packaging/macos/Info.plist.in"
plist="$app/Contents/Info.plist"
while IFS= read -r line || [[ -n "$line" ]]; do
	case "$line" in
	"@SCHEMES@") printf '%s\n' "$scheme_lines" ;;
	"@ICON@") [[ -z "$icon_lines" ]] || printf '%s\n' "$icon_lines" ;;
	*)
		line="${line//@NAME@/$name}"
		line="${line//@BUNDLE_ID@/$bundle_id}"
		line="${line//@VERSION@/$short_version}"
		line="${line//@BUILD@/$build}"
		printf '%s\n' "$line"
		;;
	esac
done <"$template" >"$plist"
printf 'APPL????' >"$app/Contents/PkgInfo"

if [[ "$(uname)" == Darwin ]]; then
	plutil -lint "$plist" >/dev/null
	if [[ -n "${MATTY_SIGN_IDENTITY:-}" ]]; then
		codesign --force --sign "$MATTY_SIGN_IDENTITY" --options runtime --timestamp "$app"
	else
		# Ad hoc: no certificate, but macOS then gives the bundle a stable
		# identity for notifications.
		codesign --force --sign - --timestamp=none "$app"
	fi
	codesign --verify --strict --verbose=1 "$app"
else
	echo "not on macOS: $app is unsigned" >&2
fi
echo "$app"
