#!/usr/bin/env bash
# Builds "target/Matty Dev.app": the debug binary in an ad-hoc signed bundle
# with its own id and URL schemes, so notifications and links work in
# development (#143) and it never fights a release install.
#
#   scripts/dev-bundle             build the debug binary and bundle it
#   scripts/dev-bundle --release   the same with a release build
#   MATTY_BIN=path scripts/dev-bundle   bundle a binary built elsewhere
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

profile=debug
if [[ "${1:-}" == "--release" ]]; then
	profile=release
fi

bin="${MATTY_BIN:-}"
if [[ -z "$bin" ]]; then
	if [[ "$profile" == release ]]; then
		cargo build --release -p matty
	else
		cargo build -p matty
	fi
	bin="target/$profile/matty"
fi
[[ -x "$bin" ]] || { echo "no binary at $bin" >&2; exit 1; }

# The scheme and id differ from the release bundle's (scripts/release-bundle),
# so the two can be installed side by side.
exec scripts/macos-bundle --name "Matty Dev" --id dev.arya.matty.dev \
	--scheme mattermost-dev --scheme matty-dev \
	--bin "$bin" --out target
