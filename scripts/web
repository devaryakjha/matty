#!/usr/bin/env bash
# Builds Matty for the browser and deploys it to https://matty.jha.sh
# (Cloudflare Workers static assets). See docs/web.md.
#
#   scripts/web setup            install the toolchain pieces the build needs
#   scripts/web build [--dev]    build into crates/matty-web/dist (release by default)
#   scripts/web serve [--dev]    build, then serve on http://127.0.0.1:8080
#   scripts/web deploy           release build, then `wrangler deploy`
#
# Environment: MATTY_WEB_PORT (serve, default 8080).
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

# gpuicn's release-pins.toml [wasm]: GPUI's web platform shares memory with
# worker threads, which needs a nightly std rebuilt with atomics.
toolchain=nightly-2026-08-17
crate=crates/matty-web
dist="$crate/dist"
target_dir="$root/target/web"

# wasm-bindgen's CLI must match the library version in Cargo.lock exactly.
bindgen_version() {
    awk '/^name = "wasm-bindgen"$/ { getline; gsub(/version = |"/, ""); print; exit }' Cargo.lock
}

# SQLite is C, built for wasm32 by clang. Apple's clang has no wasm32
# target, so on macOS look for Homebrew's LLVM (keg-only, so it is never on
# PATH), at either Homebrew prefix and at any version.
has_wasm32() {
    [[ -x "$1" ]] && [[ "$("$1" --print-targets 2>/dev/null)" == *wasm32* ]]
}

find_wasm_clang() {
    local dir
    for dir in \
        "$(brew --prefix llvm 2>/dev/null || true)" \
        /opt/homebrew/opt/llvm /usr/local/opt/llvm \
        /opt/homebrew/opt/llvm@* /usr/local/opt/llvm@*; do
        if [[ -n "$dir" ]] && has_wasm32 "$dir/bin/clang"; then
            echo "$dir/bin"
            return
        fi
    done
}

use_wasm_clang() {
    # Elsewhere the system clang has the target (CI uses Ubuntu's).
    if [[ "$(uname)" != "Darwin" || -n "${CC_wasm32_unknown_unknown:-}" ]]; then
        return
    fi
    local bin
    bin="$(find_wasm_clang)"
    if [[ -z "$bin" ]]; then
        echo "error: SQLite is built for the browser with clang, and Apple's clang has no wasm32 target." >&2
        echo "  Install Homebrew's LLVM, then try again:" >&2
        echo "    brew install llvm" >&2
        echo "  or point at a clang that has it: CC_wasm32_unknown_unknown=/path/to/clang" >&2
        exit 1
    fi
    export CC_wasm32_unknown_unknown="$bin/clang"
    if [[ -x "$bin/llvm-ar" ]]; then
        export AR_wasm32_unknown_unknown="$bin/llvm-ar"
    fi
}

setup() {
    rustup toolchain install "$toolchain" --profile minimal \
        --component rust-src --target wasm32-unknown-unknown
    cargo install wasm-bindgen-cli --locked --version "$(bindgen_version)"
    if [[ "$(uname)" == "Darwin" ]]; then
        if ! command -v brew >/dev/null; then
            echo "error: setup needs Homebrew (https://brew.sh) for LLVM and binaryen" >&2
            exit 1
        fi
        brew install llvm binaryen
    elif ! command -v wasm-opt >/dev/null; then
        echo "note: install binaryen (wasm-opt) for a smaller download, e.g. apt install binaryen"
    fi
    use_wasm_clang
    echo "ready: scripts/web build"
}

build() {
    local profile=web
    [[ "${1:-}" == "--dev" ]] && profile=dev
    use_wasm_clang
    if ! command -v wasm-bindgen >/dev/null \
        || [[ "$(wasm-bindgen --version | awk '{print $2}')" != "$(bindgen_version)" ]]; then
        echo "error: wasm-bindgen $(bindgen_version) is needed; run scripts/web setup" >&2
        exit 1
    fi

    export CARGO_UNSTABLE_BUILD_STD=std,panic_abort
    export CARGO_TARGET_DIR="$target_dir"
    export CFLAGS_wasm32_unknown_unknown="-matomics -mbulk-memory -mmutable-globals"
    # Shared memory for GPUI's worker threads, as gpuicn's showcase builds it.
    export CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUSTFLAGS="-C target-feature=+atomics,+bulk-memory,+mutable-globals \
-C link-arg=--shared-memory -C link-arg=--max-memory=1073741824 -C link-arg=--import-memory \
-C link-arg=--export=__wasm_init_tls -C link-arg=--export=__tls_size \
-C link-arg=--export=__tls_align -C link-arg=--export=__tls_base -C link-arg=--export=__heap_base"
    cargo +"$toolchain" build --locked -p matty-web --target wasm32-unknown-unknown --profile "$profile"

    local out="$target_dir/wasm32-unknown-unknown/$([[ $profile == dev ]] && echo debug || echo "$profile")"
    rm -rf "$dist"
    mkdir -p "$dist"
    wasm-bindgen --target web --out-dir "$dist" "$out/matty-web.wasm"
    if [[ "$profile" == web ]] && command -v wasm-opt >/dev/null; then
        # The features rustc's wasm32 target emits, plus threads. Not
        # --all-features: newer binaryen then emits imports browsers reject.
        wasm-opt -Oz --enable-threads --enable-bulk-memory --enable-mutable-globals \
            --enable-nontrapping-float-to-int --enable-sign-ext --enable-reference-types \
            --enable-multivalue "$dist/matty-web_bg.wasm" -o "$dist/matty-web_bg.wasm"
    fi
    cp "$crate"/web/* "$dist/"
    cp "$crate/assets/IBMPlexSans-LICENSE.txt" "$dist/"

    local largest
    largest="$(find "$dist" -type f -size +25M)"
    if [[ -n "$largest" ]]; then
        if [[ "$profile" == web ]]; then
            echo "error: Cloudflare serves files up to 25 MiB; too big: $largest" >&2
            exit 1
        fi
        echo "note: a dev build is too big for Cloudflare (25 MiB a file); deploy a release build"
    fi
    ls -lh "$dist"
}

serve() {
    build "$@"
    # Threads need the same COOP/COEP headers the deployed site sends.
    MATTY_WEB_PORT="${MATTY_WEB_PORT:-8080}" python3 - "$dist" <<'PY'
import functools, http.server, os, sys
class Handler(http.server.SimpleHTTPRequestHandler):
    def end_headers(self):
        self.send_header("Cross-Origin-Opener-Policy", "same-origin")
        self.send_header("Cross-Origin-Embedder-Policy", "require-corp")
        self.send_header("Cache-Control", "no-store")
        super().end_headers()
Handler.extensions_map[".wasm"] = "application/wasm"
port = int(os.environ["MATTY_WEB_PORT"])
print(f"serving http://127.0.0.1:{port}/ (?preview=1 for sample data)")
http.server.ThreadingHTTPServer(("127.0.0.1", port), functools.partial(Handler, directory=sys.argv[1])).serve_forever()
PY
}

deploy() {
    build
    # Signs in through the browser the first time; CLOUDFLARE_API_TOKEN works too.
    (cd "$crate" && npx --yes wrangler@4 deploy)
}

case "${1:-}" in
    setup) setup ;;
    build) shift; build "$@" ;;
    serve) shift; serve "$@" ;;
    deploy) deploy ;;
    *)
        sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
        exit 2
        ;;
esac
